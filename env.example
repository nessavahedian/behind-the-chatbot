# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional -- Google Sheets transcript logging.
# If either of these is missing, logging is silently skipped (no crash).
GSHEET_NAME=Behind the Chatbot Transcripts
# The full contents of your Google service account JSON key, as one line.
GCP_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}
